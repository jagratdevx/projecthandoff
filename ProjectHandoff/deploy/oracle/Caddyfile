# ProjectHandoff — Caddy site configuration
# __DOMAIN__ and __APP_DIR__ are replaced by deploy/oracle/bootstrap.sh.
__DOMAIN__ {
	encode zstd gzip

	# API requests go to the FastAPI backend.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Everything else is the React single-page app.
	handle {
		root * __APP_DIR__/frontend/dist
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
