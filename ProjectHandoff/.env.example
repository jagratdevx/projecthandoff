# ProjectHandoff backend configuration
# Copy to ProjectHandoff/.env and fill in real values. NEVER commit .env.

# --- Security ---
# REQUIRED in production. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PH_SECRET_KEY=change-me-insecure-development-secret

# --- Storage mode ---
# auto        : use Google Drive when OAuth tokens exist, otherwise start-up fails with instructions
# drive       : require Google Drive (production)
# local       : explicit local-development mode (CSV files on this machine, clearly labelled in the UI)
PH_STORAGE_MODE=auto
# Only honored when PH_STORAGE_MODE=local — an explicit opt-in for development.
PH_ALLOW_LOCAL_STORAGE=true

# --- Google OAuth (organizer account) ---
# From https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
PH_GOOGLE_CLIENT_ID=
PH_GOOGLE_CLIENT_SECRET=
# Must match a URI registered on the OAuth client exactly
PH_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/drive/oauth/callback
# Where the backend stores the organizer's OAuth token (gitignored)
PH_GOOGLE_TOKEN_FILE=.tokens/token.json

# --- Google Drive layout ---
# Leave empty to auto-create a folder named PH_DRIVE_ROOT_FOLDER_NAME in the organizer's Drive
PH_DRIVE_ROOT_FOLDER_ID=
PH_DRIVE_ROOT_FOLDER_NAME=ProjectHandoff

# --- Uploads ---
PH_MAX_UPLOAD_MB=10
PH_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,csv,txt,md,png,jpg,jpeg,gif,webp,zip

# --- CORS / URLs ---
PH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PH_FRONTEND_URL=http://localhost:5173

# --- Backups & sync ---
PH_BACKUP_RETENTION=20
PH_TOKEN_TTL_HOURS=168
