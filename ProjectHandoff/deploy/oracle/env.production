# ProjectHandoff production environment — generated by deploy/oracle/bootstrap.sh
# Keep this file private (it contains the JWT/invite signing key).

PH_SECRET_KEY=__SECRET__
PH_STORAGE_MODE=drive
PH_ALLOW_LOCAL_STORAGE=false

# Google OAuth. Leave the client id/secret empty and use /setup in the browser,
# or fill them here and restart the service.
# PH_GOOGLE_CLIENT_ID=
# PH_GOOGLE_CLIENT_SECRET=
PH_GOOGLE_OAUTH_REDIRECT_URI=https://__DOMAIN__/api/drive/oauth/callback
PH_GOOGLE_TOKEN_FILE=__APP_DIR__/.tokens/token.json

PH_FRONTEND_URL=https://__DOMAIN__
PH_CORS_ORIGINS=https://__DOMAIN__

PH_BACKUP_RETENTION=20
PH_TOKEN_TTL_HOURS=168
